# Copy this file to .env and fill it in. Never commit .env.

# Minecraft server the bots join (can also be changed in the panel)
HOST=play.example.com
PORT_MC=25565

# Optional: first bot to create when the database is empty
NAME=Wanderer

# Where bots, places and settings are saved.
# Leave empty to use a local data.json file instead.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/wanderbots

# Login key for the panel, used only on the very first start.
# Leave empty and a random key is printed in the log. Change it later in the panel.
PASS=

# Port for the web panel
PORT=3000
